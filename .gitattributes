# Normalize text files to LF in the repository.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Corpus files are test fixtures. Git must never change their bytes,
# because the round-trip tests compare them byte for byte (phase-0-spec B1).
/corpus/** -text
