  <linkShapes>
    <shape name="default" curviness="0.0">
      <lines>
        <line x="-0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
        <line x="0.0" visible="true">
          <dash value="1.0"></dash>
          <dash value="0.0"></dash>
        </line>
        <line x="0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
      </lines>
      <indicator>
        <shape name="link direction" rotatable="true" editableColorIndex="0">
          <line endX="90" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
          <line endX="210" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
        </shape>
      </indicator>
    </shape>
  </linkShapes>
  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="N3-limit1" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>fit-correlation</metric>
        <metric>fit-l2</metric>
        <metric>count households</metric>
        <metric>extinction-year</metric>
        <metric>peak1-capacity</metric>
        <metric>peak2-capacity</metric>
        <metric>capacity-peak-ratio</metric>
        <metric>peak1-population</metric>
        <metric>peak2-population</metric>
        <metric>population-peak-ratio</metric>
        <metric>sim-series</metric>
        <metric>hist-series</metric>
        <metric>cap-series</metric>
        <metric>mean-farmed-quality</metric>
        <metric>dead-cells</metric>
        <metric>soil-1130</metric>
        <metric>soil-1260</metric>
        <metric>max [cumulative-farm-years] of patches</metric>
        <metric>soil-series</metric>
        <metric>mean-crowding</metric>
        <metric>max-crowding</metric>
        <metric>peak1-crowded</metric>
        <metric>peak2-crowded</metric>
        <metric>crowded-peak-ratio</metric>
        <metric>capc-series</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="fertility">
          <value value="0.155"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="death-age">
          <value value="38"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="fertility-ends-age">
          <value value="34"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="harvest-adjustment">
          <value value="0.54"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="harvest-variance">
          <value value="0.4"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="historic-view?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="map-view">
          <value value="&quot;zones&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="uplands-fix?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="setup-yield-fix?">
          <value value="false"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="soil-heterogeneity">
          <value value="0.4"></value>
